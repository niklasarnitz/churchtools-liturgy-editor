# The key of the extension registered in ChurchTools.
VITE_KEY=liturgy-editor

# Optional local-development API/session values. Never commit real credentials.
VITE_BASE_URL=https://your-instance.church.tools
VITE_USERNAME=
VITE_PASSWORD=

# Optional URL of the deployed/local lectionar service.
VITE_LECTIONAR_API_URL=http://localhost:3000
